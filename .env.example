# klab production environment
# Copy to `.env.local` for development. Never commit real secrets.

# --- Database (Neon Postgres) ---
# Pooled connection used by the deployed application.
DATABASE_URL=
# Direct connection used only by `pnpm db:migrate`.
DATABASE_URL_UNPOOLED=

# --- Better Auth ---
# Generate at least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Canonical production origin, with no trailing path (for example https://klab.dev).
# Local development defaults to http://localhost:3000; production has no default.
BETTER_AUTH_URL=

# --- GitHub OAuth (optional provider) ---
# Callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Verified email/password + magic links (optional provider) ---
# Both values are required. Email/password is disabled unless delivery is configured.
RESEND_API_KEY=
EMAIL_FROM="klab <auth@example.com>"

# --- Distributed API rate limiting (strongly recommended in production) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Test only ---
# Never set this in a deployed environment.
# E2E_TEST_LOGIN=1
