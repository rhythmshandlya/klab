# klab environment — ALL OPTIONAL.
# With nothing set, klab runs as a guest-only static app (localStorage, no accounts).
# Copy to `.env.local` and fill in to enable the backend. Never commit real secrets.

# --- Database (Neon Postgres via the Vercel Marketplace) ---
# Pooled connection string, used by the app at runtime.
DATABASE_URL=
# Direct (unpooled) connection string, used ONLY by `pnpm db:migrate`/`db:push`.
DATABASE_URL_UNPOOLED=

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Absolute base URL of the deployment (e.g. http://localhost:3000 in dev).
BETTER_AUTH_URL=http://localhost:3000

# --- GitHub OAuth (create at https://github.com/settings/developers) ---
# Authorization callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email (Resend) — needed for magic-link + email verification ---
RESEND_API_KEY=
EMAIL_FROM="klab <no-reply@example.com>"

# --- Test only ---
# Enables the test login route for the authed E2E project. Never set in production.
# E2E_TEST_LOGIN=1
